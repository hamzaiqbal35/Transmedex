{
  "name": "monorepo",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\" \"npm run dev --prefix apps/api\"",
    "build": "npm run build --prefix apps/web",
    "start": "node apps/api/src/main.js",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\" \"npm run lint --prefix apps/api\""
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "brace-expansion": "^1.1.21",
    "braces": "^3.0.3",
    "nodemailer": "^10.1.7",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "browserslist": "^4.28.7",
    "ip-address": "^10.7.1",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "postcss": "^8.5.23",
    "shell-quote": "^1.9.0",
    "vite": "^7.3.5",
    "esbuild": "^0.28.2",
    "postcss-selector-parser": "7.1.6",
    "morgan": "^1.12.1",
    "qs": "^6.16.0",
    "body-parser": "^2.3.0",
    "@babel/core": "^7.29.6"
  },
  "workspaces": [
    "apps/*"
  ]
}